{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [],
      "env": [
        "VERCEL_*",
        "EXPRESS_SLACK_SIGNING_SECRET",
        "EXPRESS_SLACK_CLIENT_ID",
        "EXPRESS_SLACK_CLIENT_SECRET",
        "SLACK_STATE_SECRET",
        "TOKEN_ENCRYPTION_SECRET",
        "KV_REST_API_URL",
        "KV_REST_API_TOKEN"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        ".env.production",
        ".env.production.local"
      ]
    },
    "dev": {
      "passThroughEnv": ["$TURBO_EXTENDS$", "EXPRESS_SLACK_*"]
    }
  }
}
