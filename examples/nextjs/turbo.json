{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "VERCEL_*",
        "SLACK_SIGNING_SECRET",
        "SLACK_BOT_TOKEN",
        "MANIFEST_PATH",
        "REDIS_URL",
        "KV_REST_API_URL",
        "KV_REST_API_READ_ONLY_TOKEN",
        "KV_URL",
        "KV_REST_API_TOKEN"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        ".env.production",
        ".env.production.local"
      ]
    }
  }
}
