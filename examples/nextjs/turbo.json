{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["VERCEL_*", "SLACK_SIGNING_SECRET", "SLACK_BOT_TOKEN"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        ".env.production",
        ".env.production.local"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    }
  }
}
