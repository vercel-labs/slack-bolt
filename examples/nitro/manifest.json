{
  "display_information": {
    "name": "Nitro Bolt Starter",
    "description": "A starter template for building Bolt apps with Nitro",
    "long_description": "Nitro Bolt Starter is a template Slack app built with Typescript, Nitro, and the Slack Bolt framework, deployed on Vercel. It replies to “hello” messages giving you a foundation for building custom Slack bots, integrations, and workflows.",
    "background_color": "#000000"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true,
      "agent_tasks_enabled": true
    },
    "bot_user": {
      "display_name": "Nitro Bolt Starter",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Run sample shortcut",
        "type": "global",
        "callback_id": "sample_shortcut_id",
        "description": "Runs a sample shortcut"
      }
    ],
    "slash_commands": [
      {
        "command": "/sample-command",
        "description": "Runs a sample command",
        "should_escape": false,
        "url": "https://example.com/api/slack/events"
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": ["https://example.com/api/slack/events"],
    "scopes": {
      "bot": ["channels:history", "chat:write", "commands"]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened",
        "app_uninstalled",
        "message.channels",
        "tokens_revoked"
      ],
      "request_url": "https://example.com/api/slack/events"
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://example.com/api/slack/events"
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "is_mcp_enabled": false,
    "token_rotation_enabled": true,
    "app_level_token_rotation_enabled": false
  }
}
