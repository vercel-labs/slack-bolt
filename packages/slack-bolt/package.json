{
  "name": "@vercel/slack-bolt",
  "version": "1.7.3",
  "description": "A Vercel receiver for building Slack apps with Bolt and deploying them to Vercel",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "bin": {
    "vercel-slack": "./bin/vercel-slack.js"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./v2": {
      "types": {
        "import": "./dist/index-v2.d.mts",
        "require": "./dist/index-v2.d.ts"
      },
      "import": "./dist/index-v2.mjs",
      "require": "./dist/index-v2.js"
    },
    "./preview": {
      "types": {
        "import": "./dist/preview.d.mts",
        "require": "./dist/preview.d.ts"
      },
      "import": "./dist/preview.mjs",
      "require": "./dist/preview.js"
    }
  },
  "typesVersions": {
    "*": {
      "preview": [
        "./dist/preview.d.ts"
      ],
      "v2": [
        "./dist/index-v2.d.ts"
      ]
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel-labs/slack-bolt"
  },
  "bugs": {
    "url": "https://github.com/vercel-labs/slack-bolt/issues"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "oxlint src && oxfmt --check src",
    "lint:fix": "oxlint --fix src && oxfmt src",
    "attw": "attw --pack ."
  },
  "keywords": [
    "vercel",
    "bolt",
    "slack"
  ],
  "author": "Vercel",
  "license": "MIT",
  "dependencies": {
    "@slack/logger": "^5.0.0",
    "@slack/oauth": "3.0.5",
    "@vercel/functions": "^3.10.1",
    "commander": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@slack/bolt": "^5.1.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "^0.23.1",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@slack/bolt": "^4.7.3 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@slack/bolt": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
